# ==========================================================
# Farbetter Monorepo Environment Configuration (.env.example)
# ==========================================================
# Copy this file or configure separately in client/ and server/:
#   - client/.env.example -> client/.env
#   - server/.env.example -> server/.env

# --- Backend (server/.env) ---
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/farbetter
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@farbetter.com
ADMIN_PASSWORD=AdminPassword123!
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Farbetter <onboarding@resend.dev>
SUPPORT_EMAIL=support@farbetter.com

# --- Frontend (client/.env) ---
VITE_SERVER_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
