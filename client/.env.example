# ===================================================
# Farbetter Frontend Environment Variables (.env.example)
# ===================================================

# Backend API Endpoint
VITE_SERVER_URL=http://localhost:5000

# Razorpay Client-Side Key (Public Key)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional Admin Credentials (For initial dev dashboard access)
VITE_ADMIN_EMAIL=admin@farbetter.com
VITE_ADMIN_PASSWORD=AdminSecurePassword123!
